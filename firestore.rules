rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isChatMember(chatId) {
      return signedIn()
        && chatId.matches('(^|_)' + request.auth.uid + '(_|$)');
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(userId);
      allow update: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isChatMember(resource.data.chatId);

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && isChatMember(request.resource.data.chatId);

      allow update: if signedIn()
        && isChatMember(resource.data.chatId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status'
        ]);

      allow delete: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if signedIn()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || isAdmin()
        );

      allow create, update: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.users;

      allow create, update: if signedIn()
        && request.auth.uid in request.resource.data.users;

      allow delete: if isAdmin();
    }

    match /typing/{typingId} {
      allow read: if signedIn()
        && isChatMember(resource.data.chatId);

      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isChatMember(request.resource.data.chatId);

      allow delete: if isAdmin();
    }

    match /planJoins/{joinId} {
      allow read: if signedIn()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || isAdmin()
        );

      allow create, update: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if signedIn()
        && (
          resource.data.blockerId == request.auth.uid
          || resource.data.blockedUserId == request.auth.uid
          || isAdmin()
        );

      allow create, update: if signedIn()
        && request.resource.data.blockerId == request.auth.uid;

      allow delete: if signedIn()
        && (
          resource.data.blockerId == request.auth.uid
          || isAdmin()
        );
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;

      allow read, update, delete: if isAdmin();
    }

    match /supportRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    match /deletionRequests/{requestId} {
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /appErrors/{errorId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
